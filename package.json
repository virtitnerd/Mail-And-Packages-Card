{
  "name": "home-assistant-mail-and-packages-custom-card",
  "version": "0.0.0-dev",
  "description": "Lovelace companion card for the Mail and Packages custom integration",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards"
  ],
  "type": "module",
  "module": "Home-Assistant-Mail-And-Packages-Custom-Card.js",
  "repository": "git@github.com:virtitnerd/Mail-And-Packages-Card.git",
  "author": "Christopher <christopher@moralmunky.com>",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.3.3",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup": "^4.65.1",
    "rollup-plugin-serve": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "start": "rollup -c rollup.config.dev.js --watch",
    "build": "npm run lint && npm run rollup",
    "lint": "eslint src --ext .ts",
    "rollup": "rollup -c rollup.config.js",
    "prepare": "husky"
